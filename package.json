{
  "name": "polaris",
  "version": "1.0.0",
  "private": true,
  "description": "POLARIS - Polar Research & Information System",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "db:generate": "prisma generate --schema=server/prisma/schema.prisma",
    "db:push": "prisma db push --schema=server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.js",
    "build": "cd client && npm install && npx vite build"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
